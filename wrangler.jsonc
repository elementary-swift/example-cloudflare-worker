{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elementaryui-cloudflare-worker-demo",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}